<Page
    x:Class="RapooControl.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageLayout}">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="設定" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Style="{StaticResource SettingsSectionStyle}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="デバイス" />
                    <TextBlock x:Name="DeviceNotice" Style="{StaticResource PageSubtitleStyle}" Visibility="Collapsed" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="{x:Bind Feedback.Message, Mode=OneWay}"
                        Visibility="{x:Bind Feedback.HasMessage, Mode=OneWay}" />
                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="マウス ファームウェア" />
                        <TextBlock x:Name="MouseFirmware" Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="—" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="レシーバー ファームウェア" />
                        <TextBlock x:Name="DongleFirmware" Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="—" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="ファームウェア更新" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <Button x:Name="UpdaterButton" Click="OpenUpdater_Click" Content="公式ソフトを開く" />
                            <Button x:Name="BrowseButton" Click="BrowseUpdater_Click" Content="ファイルを選択" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="マウスの初期化" />
                        <Button x:Name="ResetButton" Grid.Column="1" VerticalAlignment="Center"
                            Click="FactoryReset_Click" Content="工場出荷時設定に戻す" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Style="{StaticResource SettingsSectionStyle}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="接続と動作" />
                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="ゲーム優先モード（0-TX）" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                Text="0-TX 中はマウスへの読み書きを停止します。設定を変更するには通常に戻してください。" />
                        </StackPanel>
                        <Button x:Name="ModeButton" Grid.Column="1" VerticalAlignment="Center" Click="PollingMode_Click" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="デモモード" />
                        <Button x:Name="DemoButton" Grid.Column="1" VerticalAlignment="Center" Click="DemoMode_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
