<Page
    x:Class="RapooControl.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="960"
            Padding="24"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="設定" />
            <TextBlock
                Style="{StaticResource PageSubtitleStyle}"
                Text="アプリのデータソースと Windows 統合の状態を確認します。" />

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="設定の保存、トレイ常駐、自動起動はまだ実装していません。表示のみのプレースホルダーです。"
                Severity="Informational"
                Title="プロトタイプ" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="データソース" />

                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource MetricLabelStyle}" Text="実装" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ServiceName, Mode=OneWay}" />

                        <TextBlock Grid.Row="1" Style="{StaticResource MetricLabelStyle}" Text="モード" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.MockLabel, Mode=OneWay}" />

                        <TextBlock Grid.Row="2" Style="{StaticResource MetricLabelStyle}" Text="接続先" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="なし (インプロセス モック)" />

                        <TextBlock Grid.Row="3" Style="{StaticResource MetricLabelStyle}" Text="将来の Go ブリッジ" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="ローカル HTTP/JSON または名前付きパイプ" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="RefreshButton_Click" Content="モックデータを再読み込み" />
                        <TextBlock
                            x:Name="RefreshStatusText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Windows 統合 (未実装)" />

                    <ToggleSwitch
                        Header="閉じたらトレイに格納"
                        IsEnabled="False"
                        IsOn="True" />
                    <ToggleSwitch
                        Header="Windows 起動時に自動起動"
                        IsEnabled="False"
                        IsOn="False" />

                    <TextBlock
                        Style="{StaticResource MetricLabelStyle}"
                        Text="既存の Wails アプリはレジストリとトレイアイコンを実装済みです。WinUI 版では Microsoft.UI.Windowing / Win32 のトレイ実装を別サービスに切り出します。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="このプロトタイプについて" />
                    <TextBlock
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="• 画面は WinUI 3 / Windows App SDK 1.8、.NET 9 で実装し、非パッケージ・自己完結でビルドします。" />
                    <TextBlock
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="• デバイスアクセスは IRapooService の背後に隠蔽し、現在は MockRapooService のみです。" />
                    <TextBlock
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="• HID 接続、ファームウェア書き込み、プロファイル保存は実装していません。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
