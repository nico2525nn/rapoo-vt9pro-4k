<Page
    x:Class="RapooControl.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageLayout}">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="設定" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Margin="0,0,0,4" Style="{StaticResource SubtitleTextBlockStyle}" Text="データ" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="サンプルデータ" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="RefreshButton_Click"
                            Content="再読み込み" />
                    </Grid>
                    <TextBlock
                        x:Name="RefreshStatusText"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Margin="0,0,0,4" Style="{StaticResource SubtitleTextBlockStyle}" Text="Windows" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="閉じるボタンでトレイに格納" />
                        <ToggleSwitch
                            Grid.Column="1"
                            AutomationProperties.Name="閉じるボタンでトレイに格納"
                            IsEnabled="False"
                            IsOn="True" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="Windows スタートアップ" />
                        <ToggleSwitch
                            Grid.Column="1"
                            AutomationProperties.Name="Windows スタートアップ"
                            IsEnabled="False"
                            IsOn="False" />
                    </Grid>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Windows 統合はプレビューでは利用できません。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
