<Page
    x:Class="RapooControl.Views.SensorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageLayout}">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="センサー" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Margin="0,0,0,4" Style="{StaticResource SubtitleTextBlockStyle}" Text="トラッキング" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="センサー" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="PixArt PAW3395" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="リフトオフディスタンス" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="1.0 mm" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="センサー角度" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="0°" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="Motion Sync" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="オン" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="ガラス面モード" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="オフ" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Margin="0,0,0,4" Style="{StaticResource SubtitleTextBlockStyle}" Text="スイッチと電源" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="押下デバウンス" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="4 ms" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="解放デバウンス" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="4 ms" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="スリープ時間" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="60 秒" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
