<UserControl
    x:Class="RapooControl.Views.DeviceHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="24,12"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border
                    Width="44"
                    Height="44"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="VT9" />
                </Border>

                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{Binding DeviceName}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="{Binding MockLabel}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ConnectionLabel}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="·" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding FirmwareText}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="·" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{Binding UpdatedText}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="電池" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding BatteryText}" />
                </StackPanel>
                <Rectangle
                    Width="1"
                    Height="30"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="アクティブ DPI" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding ActiveDpiText}" />
                </StackPanel>
                <Rectangle
                    Width="1"
                    Height="30"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="ポーリングレート" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding PollingRateText}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
