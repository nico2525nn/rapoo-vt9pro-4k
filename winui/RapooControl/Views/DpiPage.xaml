<Page
    x:Class="RapooControl.Views.DpiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RapooControl.ViewModels">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageLayout}">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="DPI" />

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="ポーリングレート" />
                    <ComboBox
                        Grid.Column="1"
                        Width="160"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="ポーリングレート"
                        ItemsSource="{x:Bind ViewModel.Dpi.PollingRateOptions}"
                        SelectedIndex="{x:Bind ViewModel.Dpi.PollingRateIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="ステージ" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="ステージ数"
                            ItemsSource="{x:Bind ViewModel.Dpi.StageCountOptions}"
                            SelectedIndex="{x:Bind ViewModel.Dpi.StageCountIndex, Mode=TwoWay}" />
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Header="使用ステージ"
                            ItemsSource="{x:Bind ViewModel.Dpi.CurrentStageOptions, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.Dpi.CurrentStageIndex, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="ステージ" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Text="X (DPI)" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MetricLabelStyle}" Text="Y (DPI)" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Dpi.Stages, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DpiStageViewModel">
                                <Grid
                                    Style="{StaticResource SettingsRowStyle}"
                                    Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="{x:Bind Label}" />
                                    <NumberBox
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind XLabel}"
                                        LargeChange="100"
                                        Maximum="26000"
                                        Minimum="50"
                                        SmallChange="50"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind X, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind YLabel}"
                                        LargeChange="100"
                                        Maximum="26000"
                                        Minimum="50"
                                        SmallChange="50"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind Y, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="DPI は 50 単位で設定できます。X と Y に異なる値を設定できます。" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    Click="ApplyButton_Click"
                    Content="設定を適用"
                    IsEnabled="{x:Bind ViewModel.Dpi.CanApply, Mode=OneWay}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.Dpi.IsBusy, Mode=OneWay}" />
            </StackPanel>

            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource PageSubtitleStyle}"
                Text="{x:Bind ViewModel.Dpi.ApplyStatus, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
