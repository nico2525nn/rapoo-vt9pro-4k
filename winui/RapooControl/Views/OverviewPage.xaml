<Page
    x:Class="RapooControl.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageLayout}">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="概要" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Margin="0,0,0,4" Style="{StaticResource SubtitleTextBlockStyle}" Text="デバイス" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="モデル" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="ファームウェア" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="{x:Bind ViewModel.FirmwareText, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock
                Style="{StaticResource PageSubtitleStyle}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

            <TextBlock Style="{StaticResource MetricLabelStyle}" Text="このプレビューはサンプルデータを使用しています。" />
        </StackPanel>
    </ScrollViewer>
</Page>
