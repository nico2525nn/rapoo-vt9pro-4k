<Page
    x:Class="RapooControl.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageLayout}">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="概要" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Style="{StaticResource SettingsSectionStyle}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="デバイス" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="モデル" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" Tag="loc-skip" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="ファームウェア" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowValueStyle}" Text="{x:Bind ViewModel.FirmwareText, Mode=OneWay}" Tag="loc-skip" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock
                Style="{StaticResource PageSubtitleStyle}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Tag="loc-skip"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

            <TextBlock
                Style="{StaticResource PageSubtitleStyle}"
                Text="{x:Bind ViewModel.ConnectionMessage, Mode=OneWay}" Tag="loc-skip"
                Visibility="{x:Bind ViewModel.HasConnectionMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
