<Window
    x:Class="RapooControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="Rapoo Control">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="WindowDragArea" Height="40" VerticalAlignment="Top" Background="Transparent">
            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Rapoo Control" />
        </Grid>
        <NavigationView
            x:Name="NavView"
            AlwaysShowHeader="False"
            Margin="0,40,0,0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="240"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.PaneFooter>
                <!-- Reserve room for the actions anchored to the window below. -->
                <Border Height="52" IsHitTestVisible="False" />
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="概要" Tag="overview">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="DPI" Tag="dpi">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Target" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="センサー" Tag="sensor">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="ボタン" Tag="buttons">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="TouchPointer" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="プロファイル" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="設定" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
            </NavigationView.Content>
        </NavigationView>

        <Grid Width="{x:Bind NavView.OpenPaneLength, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <StackPanel Margin="0,0,12,12" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ReloadButton" Width="40" Height="40" MinWidth="0" Padding="0"
                    Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="再読み込み"
                    ToolTipService.ToolTip="再読み込み" IsEnabled="False" Click="Reload_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE72C;" />
                </Button>
                <Button x:Name="ApplyButton" Width="40" Height="40" MinWidth="0" Padding="0"
                    Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="適用"
                    ToolTipService.ToolTip="適用" IsEnabled="False" Click="Apply_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE73E;" />
                </Button>
            </StackPanel>
        </Grid>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ContextMenuMode="PopupMenu"
            NoLeftClickDelay="True"
            ToolTipText="Rapoo VT9 Pro 4K">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource
                    x:Name="TrayIconSource"
                    Background="#202020"
                    CornerRadius="6"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Size="32"
                    Text="--" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout x:Name="TrayMenu" Opening="TrayMenu_Opening">
                    <MenuFlyoutItem x:Name="TrayBatteryItem" IsEnabled="False" Text="Battery" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="TrayOpenItem" Text="Open Rapoo Control" />
                    <MenuFlyoutItem x:Name="TrayReloadItem" Text="Reload" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="TrayNormalItem" Text="Normal polling" />
                    <ToggleMenuFlyoutItem x:Name="TrayLowItem" Text="Low frequency" />
                    <ToggleMenuFlyoutItem x:Name="TrayPassiveItem" Text="0-TX (passive)" />
                    <ToggleMenuFlyoutItem x:Name="TrayDemoItem" Text="Demo mode" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="TrayAutoStartItem" Text="Start with Windows" />
                    <MenuFlyoutItem x:Name="TrayQuitItem" Text="Quit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
