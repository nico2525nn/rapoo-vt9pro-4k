<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.26100;net10.0-desktop;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>RapooControl</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>io.github.nico2525nn.rapoocontrol</ApplicationId>
    <!-- Versions -->
    <Version>1.5.1</Version>
    <InformationalVersion>1.5.1</InformationalVersion>
    <ApplicationDisplayVersion>1.5.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>RapooControl</ApplicationPublisher>
    <!-- Package Description -->
    <Description>RapooControl powered by Uno Platform.</Description>
    <!--
      If you encounter this error message:

        error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
        Please update to a newer .NET SDK in order to reference this assembly.

      This means that the two packages below must be aligned with the "build" version number of
      the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
      must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <WindowsSdkPackageVersion>10.0.22621.28</WindowsSdkPackageVersion> -->

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>Skia</UnoFeatures>

    <!-- Keep publish output lean: no ReadyToRun images, no framework satellite
         resources, and no documentation files. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <SidecarPath>..\..\build\bin\rapoo-bridge.exe</SidecarPath>
    <SidecarFileName>rapoo-bridge.exe</SidecarFileName>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Multi-size ICO for the exe; the resizetizer's single 64px icon.ico is
         still copied for the Skia window icon. -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'linux-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')))">$(DefineConstants);LINUX</DefineConstants>
    <SidecarPath>..\..\build\bin\rapoo-bridge</SidecarPath>
    <SidecarFileName>rapoo-bridge</SidecarFileName>
  </PropertyGroup>

  <Target Name="ValidateUnoSidecar" BeforeTargets="PrepareForPublish" Condition="'$(SidecarPath)' != ''">
    <Error Condition="!Exists('$(SidecarPath)')"
           Text="The Go sidecar is required for publishing: $(SidecarPath). Run uno/build-sidecars.sh first." />
    <Error Condition="'$(TargetFramework)' == 'net10.0-desktop' and '$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == ''"
           Text="Release publish requires an explicit runtime identifier: use -r linux-x64." />
    <Error Condition="'$(TargetFramework)' == 'net10.0-desktop' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'linux-x64'"
           Text="Only linux-x64 is supported for the Uno desktop head." />
    <Error Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'"
           Text="Only win-x64 is supported for the Uno Windows head." />
  </Target>

  <ItemGroup Condition="'$(SidecarPath)' != '' and Exists('$(SidecarPath)')">
    <Content Include="$(SidecarPath)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Link="$(SidecarFileName)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100'">
    <PackageReference Include="H.NotifyIcon.WinUI" />
  </ItemGroup>

  <!-- Symbols are not shipped. Delete them after publish instead of compiling
       with DebugType=none, because Uno's resource injector expects the PDB to
       match the assembly it is rewriting. -->
  <Target Name="RemovePublishSymbols"
          AfterTargets="Publish"
          Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_PublishSymbol Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishSymbol)" />
  </Target>

  <!-- Windows App SDK 1.8 copies the Windows ML stack (ONNX Runtime and
       DirectML, ~40 MB) into every unpackaged publish. This app never calls
       Windows ML, so drop the files after publish. -->
  <Target Name="RemoveUnusedWindowsML"
          AfterTargets="Publish"
          Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100' and '$(PublishDir)' != ''">
    <ItemGroup>
      <_UnusedWindowsMLFile Include="$(PublishDir)onnxruntime.dll" />
      <_UnusedWindowsMLFile Include="$(PublishDir)onnxruntime_providers_shared.dll" />
      <_UnusedWindowsMLFile Include="$(PublishDir)DirectML.dll" />
      <_UnusedWindowsMLFile Include="$(PublishDir)Microsoft.Windows.AI.MachineLearning.dll" />
      <_UnusedWindowsMLFile Include="$(PublishDir)Microsoft.Windows.AI.MachineLearning.Projection.dll" />
      <_UnusedWindowsMLFile Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" />
    </ItemGroup>
    <Delete Files="@(_UnusedWindowsMLFile)" />
  </Target>

  <!-- Uno's Win32 runtime references WebView2 even when the app has no WebView.
       ILLink then walks the 29-deep ICoreWebView2_* interface chain and can run
       for hours (unoplatform/uno#24618). The app never uses WebView, so hide
       those references from the linker in trimmed desktop builds. -->
  <Target Name="HideUnusedWebView2FromILLink"
          BeforeTargets="_RunILLink"
          Condition="'$(TargetFramework)' == 'net10.0-desktop' and '$(PublishTrimmed)' == 'true'">
    <ItemGroup>
      <_UnusedWebView2Reference Include="@(ReferencePath)"
                                Condition="'%(Filename)' == 'WebView2' or '%(Filename)' == 'DirectN' or '%(Filename)' == 'DirectN.Extensions'" />
      <ReferencePath Remove="@(_UnusedWebView2Reference)" />
    </ItemGroup>
  </Target>

</Project>
