<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.26100;net10.0-desktop;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>RapooControl</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.rapoocontrol</ApplicationId>
    <!-- Versions -->
    <Version>1.4.0</Version>
    <InformationalVersion>1.4.0</InformationalVersion>
    <ApplicationDisplayVersion>1.4.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>RapooControl</ApplicationPublisher>
    <!-- Package Description -->
    <Description>RapooControl powered by Uno Platform.</Description>
    <!--
      If you encounter this error message:

        error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
        Please update to a newer .NET SDK in order to reference this assembly.

      This means that the two packages below must be aligned with the "build" version number of
      the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
      must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <WindowsSdkPackageVersion>10.0.22621.28</WindowsSdkPackageVersion> -->

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Hosting;
      Mvvm;
      Skia;
    </UnoFeatures>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <SidecarPath>..\..\build\bin\rapoo-bridge.exe</SidecarPath>
    <SidecarFileName>rapoo-bridge.exe</SidecarFileName>
    <PublishTrimmed>false</PublishTrimmed>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'linux-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')))">$(DefineConstants);LINUX</DefineConstants>
    <SidecarPath>..\..\build\bin\rapoo-bridge</SidecarPath>
    <SidecarFileName>rapoo-bridge</SidecarFileName>
  </PropertyGroup>

  <Target Name="ValidateUnoSidecar" BeforeTargets="PrepareForPublish" Condition="'$(SidecarPath)' != ''">
    <Error Condition="!Exists('$(SidecarPath)')"
           Text="The Go sidecar is required for publishing: $(SidecarPath). Run uno/build-sidecars.sh first." />
    <Error Condition="'$(TargetFramework)' == 'net10.0-desktop' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'linux-x64'"
           Text="Only linux-x64 is supported for the Uno desktop head." />
    <Error Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'"
           Text="Only win-x64 is supported for the Uno Windows head." />
  </Target>

  <ItemGroup Condition="'$(SidecarPath)' != '' and Exists('$(SidecarPath)')">
    <Content Include="$(SidecarPath)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Link="$(SidecarFileName)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100'">
    <PackageReference Include="H.NotifyIcon.WinUI" />
  </ItemGroup>

</Project>
