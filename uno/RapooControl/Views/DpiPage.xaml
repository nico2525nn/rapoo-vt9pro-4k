<Page
    x:Class="RapooControl.Views.DpiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RapooControl.ViewModels"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageLayout}">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="DPI" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Style="{StaticResource SettingsSectionStyle}">
                    <TextBlock
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="{x:Bind ViewModel.DpiNotice, Mode=OneWay}" Tag="loc-skip"
                        Visibility="{x:Bind ViewModel.HasDpiNotice, Mode=OneWay}" />

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="{x:Bind Feedback.Message, Mode=OneWay}" Tag="loc-skip"
                        Visibility="{x:Bind Feedback.HasMessage, Mode=OneWay}" />
                    <Grid Style="{StaticResource SettingsRowStyle}"
                        Visibility="{x:Bind ViewModel.Dpi.HasConfiguration, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="ポーリングレート" />
                        <ComboBox
                            Grid.Column="1"
                            Width="160"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="ポーリングレート"
                            IsEnabled="{x:Bind ViewModel.Dpi.CanEdit, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Dpi.PollingRateOptions, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.Dpi.PollingRateIndex, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}"
                Visibility="{x:Bind ViewModel.Dpi.HasConfiguration, Mode=OneWay}">
                <StackPanel Style="{StaticResource SettingsSectionStyle}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="ステージ" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="ステージ数"
                            IsEnabled="{x:Bind ViewModel.Dpi.CanEdit, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Dpi.StageCountOptions}"
                            SelectedIndex="{x:Bind ViewModel.Dpi.StageCountIndex, Mode=TwoWay}" />
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Header="使用ステージ"
                            IsEnabled="{x:Bind ViewModel.Dpi.CanEdit, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Dpi.CurrentStageOptions, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.Dpi.CurrentStageIndex, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="ステージ" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Text="X (DPI)" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MetricLabelStyle}" Text="Y (DPI)" />
                    </Grid>

                    <ItemsControl IsEnabled="{x:Bind ViewModel.Dpi.CanEdit, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Dpi.Stages, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DpiStageViewModel">
                                <Grid
                                    Style="{StaticResource SettingsRowStyle}"
                                    Tag="loc-skip"
                                    Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="{x:Bind Label, Mode=OneWay}" />
                                    <NumberBox
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind XLabel, Mode=OneWay}"
                                        LargeChange="100"
                                        Maximum="26000"
                                        Minimum="50"
                                        SmallChange="50"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind X, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind YLabel, Mode=OneWay}"
                                        LargeChange="100"
                                        Maximum="26000"
                                        Minimum="50"
                                        SmallChange="50"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind Y, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="DPI は 50 単位で設定できます。X と Y に異なる値を設定できます。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
