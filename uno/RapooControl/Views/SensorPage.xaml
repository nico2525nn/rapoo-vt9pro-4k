<Page
    x:Class="RapooControl.Views.SensorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageLayout}">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="センサー" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Style="{StaticResource SettingsSectionStyle}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="トラッキング" />
                    <TextBlock x:Name="DeviceNotice" Style="{StaticResource PageSubtitleStyle}" Visibility="Collapsed" Tag="loc-skip" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="{x:Bind Feedback.Message, Mode=OneWay}" Tag="loc-skip"
                        Visibility="{x:Bind Feedback.HasMessage, Mode=OneWay}" />
                    <ContentControl x:Name="Editor" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="リフトオフディスタンス" />
                                <ComboBox x:Name="LiftOff" Grid.Column="1" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" AutomationProperties.Name="リフトオフディスタンス" DisplayMemberPath="Label" />
                            </Grid>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="センサー角度" />
                                <NumberBox x:Name="Angle" Grid.Column="1" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" AutomationProperties.Name="センサー角度" Minimum="-30" Maximum="30" SmallChange="1" SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="Motion Sync" />
                                <ToggleSwitch x:Name="MotionSync" Grid.Column="1" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" AutomationProperties.Name="Motion Sync" />
                            </Grid>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="リップル補正" />
                                <ToggleSwitch x:Name="Ripple" Grid.Column="1" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" AutomationProperties.Name="リップル補正" />
                            </Grid>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="直線補正" />
                                <ToggleSwitch x:Name="Correction" Grid.Column="1" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" AutomationProperties.Name="直線補正" />
                            </Grid>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="ガラス面モード" />
                                <ToggleSwitch x:Name="GlassMode" Grid.Column="1" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" AutomationProperties.Name="ガラス面モード" />
                            </Grid>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Border>

            <Border x:Name="PowerCard" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                <ContentControl x:Name="PowerEditor" HorizontalContentAlignment="Stretch">
                    <StackPanel Style="{StaticResource SettingsSectionStyle}">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="スイッチと電源" />
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="押下デバウンス" />
                            <ComboBox x:Name="PressDebounce" Grid.Column="1" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" AutomationProperties.Name="押下デバウンス" DisplayMemberPath="Label" />
                        </Grid>
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="解放デバウンス" />
                            <ComboBox x:Name="ReleaseDebounce" Grid.Column="1" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" AutomationProperties.Name="解放デバウンス" DisplayMemberPath="Label" />
                        </Grid>
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="スリープ時間（分）" />
                            <NumberBox x:Name="SleepMinutes" Grid.Column="1" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" AutomationProperties.Name="スリープ時間（分）" Minimum="2" Maximum="120" SmallChange="1" SpinButtonPlacementMode="Compact" />
                        </Grid>
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="LED 省電力" />
                            <ToggleSwitch x:Name="LedLowPower" Grid.Column="1" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" AutomationProperties.Name="LED 省電力" />
                        </Grid>
                    </StackPanel>
                </ContentControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
